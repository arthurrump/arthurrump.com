{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
	{{- $pages = $pctx.RegularPages }}
{{- else }}
	{{- $pages = $pctx.Pages }}
{{- end }}
{{- $pages = where $pages "Date" "ne" (time.AsTime nil) }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
	{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
	<channel>
		<title>{{ site.Title }}{{ if ne .Kind "home" }} / {{ .Title }}{{ end }}</title>
		<link>{{ .Permalink }}</link>
		<generator>Hugo</generator>
		<language>{{ site.Language.Locale }}</language>
		{{ with .Site.Copyright }}
			<copyright>{{ . }}</copyright>
		{{ end }}
		{{ if not .Date.IsZero }}
			<lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
		{{ end }}
		{{- with .OutputFormats.Get "RSS" }}
			{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
			<item>
				<title>{{ .Title }}</title>
				<link>{{ .Permalink }}</link>
				<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
				<guid isPermaLink="false">tag:{{ strings.Replace (strings.ReplaceRE "^https?://" "" site.BaseURL) "/" "" }},{{ .Date.Format "2006-01-02" }}:{{ .Permalink | relURL }}</guid>
                {{- range .Params.authors }}
                {{ printf "<dc:creator>%s</dc:creator>" . | safeHTML }}
                {{- end }}
                <description>
                    {{ .Summary | transform.XMLEscape | safeHTML }}
                    {{- if .Truncated }}
                    &lt;p&gt;&lt;a href="{{ .Permalink | absURL }}"&gt;Read more...&lt;/a&gt;&lt;/p&gt;
                    {{- end }}
                </description>
			</item>
		{{- end }}
	</channel>
</rss>
